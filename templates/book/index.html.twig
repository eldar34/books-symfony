{% extends 'base.html.twig' %}

{% block title %}Каталог книг{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Каталог книг</h1>
    {% if app.user %}
        <a href="{{ path('app_book_new') }}" class="btn btn-primary">Добавить книгу</a>
    {% endif %}
</div>

{% if books is empty %}
    <div class="card p-5 text-center text-muted">
        <h3>Книг пока нет. Будьте первым, кто добавит книгу в каталог!</h3>
    </div>
{% else %}
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
        {% for book in books %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    {% if book.coverImage %}
                        <img src="{{ asset('uploads/covers/' ~ book.coverImage) }}" class="card-img-top" alt="{{ book.title }}" style="height: 300px; object-fit: cover;">
                    {% else %}
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 300px;">
                            <span>Нет обложки</span>
                        </div>
                    {% endif %}
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate" title="{{ book.title }}">{{ book.title }}</h5>
                        <p class="card-text text-muted mb-1">Год: {{ book.releaseYear }}</p>
                        <p class="card-text small text-secondary mb-3">
                            Авторы: 
                            {% for author in book.authors %}
                                <span class="badge bg-secondary">{{ author.fullName }}</span>
                            {% endfor %}
                        </p>
                        <div class="mt-auto d-flex justify-content-between">
                            <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-sm btn-outline-primary">Смотреть</a>
                            {% if app.user %}
                                <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-sm btn-outline-warning">Редактировать</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Блок пагинации Bootstrap #}
    {% if pages_count > 1 %}
        <nav aria-label="Навигация по страницам" class="mt-4 mb-3">
            <ul class="pagination justify-content-center">
                
                {# Кнопка "Назад" #}
                <li class="page-item {{ current_page == 1 ? 'disabled' }}">
                    <a class="page-link" href="{{ path('app_book_index', {'page': current_page - 1}) }}" aria-label="Назад">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                {# Цикл по страницам #}
                {% for page in 1..pages_count %}
                    <li class="page-item {{ page == current_page ? 'active' }}">
                        <a class="page-link" href="{{ path('app_book_index', {'page': page}) }}">{{ page }}</a>
                    </li>
                {% endfor %}

                {# Кнопка "Вперед" #}
                <li class="page-item {{ current_page == pages_count ? 'disabled' }}">
                    <a class="page-link" href="{{ path('app_book_index', {'page': current_page + 1}) }}" aria-label="Вперед">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
                
            </ul>
        </nav>
    {% endif %}
    
    {# Текст счетчика #}
    <div class="text-center text-muted small mt-2 mb-5">
        Всего книг в каталоге: {{ total_items }}
    </div>
{% endif %}
{% endblock %}
