{# templates/book_crud/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Редактирование: {{ book.title }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Редактирование книги</h2>
                
                {# Форма безопасного удаления книги #}
                <form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" onsubmit="return confirm('Вы уверены, что хотите удалить эту книгу?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                    <button class="btn btn-danger btn-sm">🗑 Удалить книгу</button>
                </form>
            </div>

            {# Используем структуру полей из формы new (копирует логику оформления) #}
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.releaseYear, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.releaseYear, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.isbn, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.isbn, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
                </div>
                <div class="mb-3 card p-3 bg-light">
                    <label class="form-label d-block fw-bold">Авторы:</label>
                    <div class="row row-cols-2">
                        {% for child in form.authors %}
                            <div class="col form-check">
                                {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(child, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="mb-4">
                    {{ form_label(form.coverImageFile, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.coverImageFile, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_book_index') }}" class="btn btn-outline-secondary">Отмена</a>
                    <button type="submit" class="btn btn-warning px-4">Сохранить изменения</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
