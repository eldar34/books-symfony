{# templates/book_crud/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ book.title }}{% endblock %}

{% block body %}
<div class="card shadow-sm p-4">
    <div class="row g-4">
        <div class="col-md-4 text-center">
            {% if book.coverImage %}
                <img src="{{ asset('uploads/covers/' ~ book.coverImage) }}" class="img-fluid rounded shadow" alt="{{ book.title }}">
            {% else %}
                <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center shadow" style="height: 400px;">
                    <h4>Обложка отсутствует</h4>
                </div>
            {% endif %}
        </div>
        <div class="col-md-8">
            <h1 class="display-5 fw-bold">{{ book.title }}</h1>
            <p class="text-muted fs-5">ISBN-13: {{ book.isbn }} | Год издания: {{ book.releaseYear }}</p>
            
            <hr>
            
            <h4 class="mt-3">Авторы:</h4>
            <div class="mb-4">
                {% for author in book.authors %}
                    <span class="badge bg-primary fs-6 me-2">{{ author.fullName }}</span>
                {% endfor %}
            </div>

            <h4>Описание:</h4>
            <p class="fs-6 text-dark bg-white p-3 rounded border" style="white-space: pre-wrap;">
                {{ book.description ?: 'Описание к этой книге пока не добавлено.' }}
            </p>

            <div class="mt-4 d-flex gap-2">
                <a href="{{ path('app_book_index') }}" class="btn btn-outline-secondary">Назад в каталог</a>
                {% if app.user %}
                    <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-warning">Редактировать</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
