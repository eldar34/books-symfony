<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Книжный Каталог{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-light">
        {# Простая навигационная панель #}
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_book_index') }}">Books</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_book_index') }}">Книги</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_author_index') }}">Авторы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_report_top_authors') }}">Отчеты</a>
                        </li>
                    </ul>

                    <div class="navbar-nav">
                        {% if app.user %}
                            <span class="nav-item nav-link text-light me-3">{{ app.user.userIdentifier }}</span>
                            <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm my-auto">Logout</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm my-auto">Login</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>

        <div class="container">
            {# Вывод всплывающих сообщений (Flash-сообщений) #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </body>
</html>

