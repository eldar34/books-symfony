{% extends 'base.html.twig' %}

{% block title %}{{ author.fullName }}{% endblock %}

{% block body %}
<div class="card shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <h1 class="display-5 fw-bold mb-0">{{ author.fullName }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_author_index') }}" class="btn btn-outline-secondary">Назад к авторам</a>
            {% if app.user %}
                <a href="{{ path('app_author_edit', {'id': author.id}) }}" class="btn btn-warning">Редактировать</a>
            {% endif %}
        </div>
    </div>

    {# БЛОК ПОДПИСКИ #}
    <div class="row mb-5">
        <div class="col-md-6">
            <div class="card bg-light border-0 p-4 rounded shadow-sm">
                <h5 class="card-title fw-bold mb-2">Уведомить о новинках</h5>
                <p class="text-muted small mb-3">Подпишитесь, чтобы первыми узнавать о выходе новых книг этого автора.</p>
                
                {{ form_start(subscriber_form, {'attr': {'class': 'row g-2 align-items-center'}}) }}
                    <div class="col-sm-8">
                        {{ form_widget(subscriber_form.email) }}
                        {{ form_errors(subscriber_form.email, {'attr': {'class': 'text-danger small d-block mt-1'}}) }}
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-primary w-100">Подписаться</button>
                    </div>
                {{ form_end(subscriber_form) }}
            </div>
        </div>
    </div>

    <h4>Книги этого автора в каталоге:</h4>
    
    {% if author.books is empty %}
        <p class="text-muted">У этого автора пока нет добавленных книг.</p>
    {% else %}
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mt-1">
            {% for book in author.books %}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        {% if book.coverImage %}
                            <img src="{{ asset('uploads/covers/' ~ book.coverImage) }}" class="card-img-top" alt="{{ book.title }}" style="height: 250px; object-fit: cover;">
                        {% else %}
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 250px;">
                                <span>Нет обложки</span>
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate" title="{{ book.title }}">{{ book.title }}</h6>
                            <p class="card-text small text-muted">Год: {{ book.releaseYear }}</p>
                            <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-sm btn-outline-primary mt-auto">Смотреть книгу</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
