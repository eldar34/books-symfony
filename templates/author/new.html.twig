{% extends 'base.html.twig' %}

{% block title %}Новый автор{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <h2 class="mb-4">Добавление автора</h2>

            {{ form_start(form) }}
                <div class="mb-4">
                    {{ form_label(form.fullName, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.fullName, {'attr': {'class': 'form-control', 'placeholder': 'Введите ФИО автора'}}) }}
                    {{ form_errors(form.fullName, {'attr': {'class': 'text-danger small'}}) }}
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_author_index') }}" class="btn btn-outline-secondary">Назад к списку</a>
                    <button type="submit" class="btn btn-success px-4">Сохранить автора</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
