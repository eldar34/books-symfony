# Docker Core Configuration
COMPOSE_PROJECT_NAME=bookssmf
CONTAINER_NAME=cn-bookssmf
CONTAINER_MODE=unless-stopped

# Application Network Ports
APP_PORT=8089
REVERB_SERVER_PORT=8080

# Database Configuration
DB_PORT=5432
DB_DATABASE=bookssmf-db
DB_USERNAME=demo_bookssmf_user
DB_PASSWORD=demo_bookssmf.pass
DB_DATA_STORAGE=./docker/dockDB/data

###> symfony/mailer ###
MAILER_HTTP_PORT=8025
MAILER_SMTP_PORT=1025
MAILER_DSN=smtp://mailer:${MAILER_SMTP_PORT}
###< symfony/mailer ###